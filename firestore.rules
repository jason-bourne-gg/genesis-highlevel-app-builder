rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // HighLevel tokens live here. Functions use the admin SDK and bypass rules;
    // nothing client-side ever reads them.
    match /users/{uid}/private/{doc} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if owner(resource.data.ownerUid);
      allow create: if owner(request.resource.data.ownerUid);
      allow update, delete: if owner(resource.data.ownerUid);

      match /{sub=**} {
        allow read, write: if owner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid);
      }
    }
  }
}
