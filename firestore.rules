rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ownsProject(projectId) {
      return owner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid);
    }

    // HighLevel tokens. Functions use the admin SDK and bypass rules.
    match /users/{uid}/private/{doc} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    // Both are bearer credentials. Readable by a browser, either would let someone
    // impersonate another user.
    match /oauthStates/{nonce} {
      allow read, write: if false;
    }

    match /previewTokens/{token} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read: if owner(resource.data.ownerUid);
      allow create: if owner(request.resource.data.ownerUid);
      allow delete: if owner(resource.data.ownerUid);
      // Pinning ownerUid stops a project being handed to another account.
      allow update: if owner(resource.data.ownerUid)
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      // Manual edits and restores are written straight from the browser.
      match /files/{fileId} {
        allow read, write: if ownsProject(projectId);
      }

      // Written only by the generation function through the admin SDK. Client write
      // access would let someone rewrite the history fed back to the model.
      match /messages/{messageId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }

      match /snapshots/{snapshotId} {
        allow read: if ownsProject(projectId);
        allow write: if false;
      }

      // The generate function creates one of these per run and watches it. The
      // owner writes cancelled here to stop a generation, because a client
      // disconnect does not reliably reach the function.
      match /generations/{generationId} {
        allow read, write: if ownsProject(projectId);
      }
    }
  }
}
