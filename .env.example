# ---- functions/.env ----

# HighLevel marketplace app credentials.
# Marketplace > your app > MANAGE > Secrets > Client keys
HL_CLIENT_ID=
HL_CLIENT_SECRET=
# Signs incoming webhook payloads. Only needed for the webhooks bonus.
HL_SHARED_SECRET=

# Must byte-for-byte match a URL registered under
# Advanced Settings > Auth > Redirect URLs
HL_REDIRECT_URI=https://us-central1-<project-id>.cloudfunctions.net/oauthCallback

# Space separated. Must match the scopes ticked on the marketplace app.
HL_SCOPES=

# Draft apps have no published version; take this from the app Install link.
HL_VERSION_ID=

HL_API_BASE=https://services.leadconnectorhq.com
HL_API_VERSION=2021-07-28

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

APP_ORIGIN=http://localhost:6001

# ---- frontend/.env ----
# Firebase web config — not secret, shipped in the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Direct Cloud Run URL for the SSE endpoint. Not a Hosting path —
# Hosting rewrites buffer the response and streaming never arrives.
VITE_GENERATE_URL=
VITE_FUNCTIONS_BASE=
