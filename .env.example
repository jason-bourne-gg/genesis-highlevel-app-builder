# Copy this file into two places and fill in the blanks:
#
#   functions/.env   the first block, read by functions/src/config.ts
#   frontend/.env    the VITE_ block, read through import.meta.env in frontend/src
#
# Both of those are gitignored. This file is committed and is the only record of
# what exists, so every value here stays blank. Defaults are given in comments.
# The repository is public; nothing secret belongs in it.


# ---- functions/.env ----

# HighLevel marketplace app credentials. Required.
# Marketplace > your app > MANAGE > Secrets > Client keys
HL_CLIENT_ID=
HL_CLIENT_SECRET=

# Where HighLevel sends the browser after consent. Required.
# Must byte-for-byte match a URL registered under
# Advanced Settings > Auth > Redirect URLs on the marketplace app.
# HighLevel rejects any redirect URL containing the string "highlevel".
# OAuth needs a publicly reachable callback, so this is always a deployed
# function URL, never localhost.
#   e.g. https://us-central1-<project-id>.cloudfunctions.net/oauthCallback
HL_REDIRECT_URI=

# Space separated. Required, and must match the scopes ticked on the marketplace
# app. The endpoints in functions/src/hl/resources.ts need:
#   locations.readonly contacts.readonly conversations.readonly
#   calendars.readonly calendars/events.readonly
HL_SCOPES=

# A draft app has no published version for the authorize URL to resolve against,
# so the URL has to name one. Take it from the version_id query parameter on the
# app's Install link. Optional; leave blank once the app is published.
HL_VERSION_ID=

# HighLevel API host and dated API version. Both optional.
#   HL_API_BASE     defaults to https://services.leadconnectorhq.com
#   HL_API_VERSION  defaults to 2021-07-28
HL_API_BASE=
HL_API_VERSION=

# Where oauthCallback redirects the browser once the round trip finishes.
# Optional; defaults to http://localhost:6001. Set it to the deployed Hosting
# origin in production, or every connection attempt ends up on localhost.
# Comma separated list of origins the OAuth callback may return the browser to.
# Leave blank for a normal Firebase deploy: https://<project-id>.web.app and
# https://<project-id>.firebaseapp.com are allowed automatically, derived from the
# project id the functions runtime already knows. Set this for a custom domain or a
# local dev port, e.g.
#   APP_ORIGINS=http://localhost:6001,https://apps.example.com
# Anything not on the list is ignored and the first entry is used instead, because
# the callback is public and an unchecked redirect target is an open redirect.
APP_ORIGINS=

# Single-value form of the above, kept for compatibility. Used as the fallback
# destination when nothing else matches.
APP_ORIGIN=

# Anthropic API key, used by the generate function to call Claude. Required —
# generation returns 500 without it. Create one at console.anthropic.com under
# API keys. Billed per token, so treat it as the most sensitive value here.
ANTHROPIC_API_KEY=

# Which Claude model generates the apps. Optional; defaults to claude-opus-5.
# Any model id the Anthropic Messages API accepts works here.
ANTHROPIC_MODEL=

# Would sign incoming webhook payloads. Nothing reads this yet — webhooks are a
# bonus that is not built.
HL_SHARED_SECRET=


# ---- frontend/.env ----

# Firebase web config. Not secret; it is shipped in the client bundle by design.
# Firebase console > Project settings > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL that every non-streaming function call is appended to: oauthStart,
# hlProxy, hlDisconnect, previewToken, hlPreview. Required.
#   deployed  https://us-central1-<project-id>.cloudfunctions.net
#   emulator  http://localhost:5001/<project-id>/us-central1
VITE_FUNCTIONS_BASE=

# The generate function's own direct Cloud Run URL. Required, and deliberately
# separate from VITE_FUNCTIONS_BASE. Not a Firebase Hosting path: Hosting buffers
# the whole response at its CDN, so an event stream routed through a rewrite
# arrives all at once at the end, which is to say it does not stream at all.
# Printed by `firebase deploy --only functions`, and visible in the Google Cloud
# console under Cloud Run as the service named `generate`.
#   deployed  https://generate-<hash>-uc.a.run.app
#   emulator  http://localhost:5001/<project-id>/us-central1/generate
VITE_GENERATE_URL=
